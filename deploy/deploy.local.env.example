# Образец. Скопируйте в deploy.local.env и заполните — тот файл в git не попадает (.gitignore).
# Хук pre-commit не пустит в коммит ни одно значение из deploy.local.env.

# Сервер: имя в Tailscale — один путь и дома, и в поездке
DEPLOY_HOST=
DEPLOY_USER=
# Путь с пробелами — в кавычках
DEPLOY_PATH=

# Только для хука: адреса сервера, которые не должны попасть в публичный репозиторий
SERVER_LAN_IP=
SERVER_TAILSCALE_IP=
