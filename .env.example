# Образец: только имена. Настоящий .env создаётся вручную на сервере, в папке бота,
# с правами 600. В git и на Мак он не попадает, выкладка его не трогает.

# Токен бота @jw_site_check_bot от @BotFather
BOT_TOKEN=
# Ключ Google Cloud, ограниченный одним PageSpeed Insights API
PAGESPEED_API_KEY=
# Telegram ID владельца: /stats, /site, уведомления, полный доступ до запуска
ADMIN_ID=
